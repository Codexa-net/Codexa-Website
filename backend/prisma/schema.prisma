generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  email     String    @db.VarChar(255)
  phone     String?   @db.VarChar(30)
  subject   String?   @db.VarChar(200)
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, role])
  @@map("admin_users")
}
model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects Project[]

  @@map("portfolio_categories")
}

model Technology {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(100)
  slug      String    @unique @db.VarChar(120)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects Project[]

  @@map("portfolio_technologies")
}

model Project {
  id           String       @id @default(uuid()) @db.Uuid
  title        String       @db.VarChar(200)
  slug         String       @unique @db.VarChar(220)
  description  String       @db.Text
  imageUrl     String?      @db.VarChar(500)
  githubUrl    String?      @db.VarChar(500)
  liveUrl      String?      @db.VarChar(500)
  isFeatured   Boolean      @default(false)
  categoryId   String       @db.Uuid
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  technologies Technology[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([categoryId])
  @@index([isFeatured])
  @@index([createdAt])
  @@map("portfolio_projects")
}

model WebsiteSettings {
  id String @id @default("default") @db.VarChar(50)

  // Company information
  companyName String  @default("Codexa") @db.VarChar(200)
  slogan      String? @db.VarChar(300)
  description String? @db.Text
  logoUrl     String? @db.VarChar(500)
  faviconUrl  String? @db.VarChar(500)

  // About us
  aboutTitle       String?  @db.VarChar(200)
  aboutDescription String?  @db.Text
  mission          String?  @db.Text
  vision           String?  @db.Text
  values           String[] @default([])

  // Contact information
  contactEmail   String? @db.VarChar(255)
  contactPhone   String? @db.VarChar(30)
  contactAddress String? @db.VarChar(500)
  workingHours   String? @db.VarChar(200)
  mapLocationUrl String? @db.VarChar(500)

  // SEO settings
  metaTitle       String?  @db.VarChar(200)
  metaDescription String?  @db.VarChar(500)
  metaKeywords    String[] @default([])
  ogImageUrl      String?  @db.VarChar(500)
  twitterHandle   String?  @db.VarChar(50)
  canonicalUrl    String?  @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("website_settings")
}

model SocialLink {
  id           String   @id @default(uuid()) @db.Uuid
  platform     String   @db.VarChar(50)
  url          String   @db.VarChar(500)
  icon         String?  @db.VarChar(100)
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isEnabled, displayOrder])
  @@map("social_links")
}


model ServiceCategory {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(120)
  slug         String    @unique @db.VarChar(140)
  description  String?   @db.Text
  iconUrl      String?   @db.VarChar(500)
  displayOrder Int       @default(0)
  services     Service[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("service_categories")
}

model Service {
  id               String          @id @default(uuid()) @db.Uuid
  title            String          @db.VarChar(200)
  slug             String          @unique @db.VarChar(220)
  shortDescription String          @db.VarChar(300)
  description      String          @db.Text
  iconUrl          String?         @db.VarChar(500)
  imageUrl         String?         @db.VarChar(500)
  features         String[]        @default([])
  price            String?         @db.VarChar(100)
  isFeatured       Boolean         @default(false)
  isActive         Boolean         @default(true)
  displayOrder     Int             @default(0)
  categoryId       String          @db.Uuid
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([categoryId])
  @@index([isFeatured])
  @@index([isActive])
  @@index([displayOrder])
  @@map("services")
}
