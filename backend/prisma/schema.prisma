generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactMessage {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(100)
  email     String    @db.VarChar(255)
  phone     String?   @db.VarChar(30)
  subject   String?   @db.VarChar(200)
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

enum AdminRole {
  SUPER_ADMIN
  SALES
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @db.VarChar(255)
  role         AdminRole @default(SALES)
  phone        String?   @db.VarChar(30)
  avatar       String?   @db.Text
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, role])
  @@map("admin_users")
}

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  category    String?  @db.VarChar(100)
  description String?  @db.Text
  basePrice   Float    @default(0)
  status      String   @default("مكتمل") @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
  @@map("services")
}

model Client {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(150)
  contact      String?  @db.VarChar(150)
  industry     String?  @db.VarChar(100)
  totalRevenue Float    @default(0)
  logo         String?  @db.VarChar(500)
  description  String?  @db.Text
  sector       String?  @db.VarChar(100)
  website      String?  @db.VarChar(500)
  displayOrder Int      @default(0)
  year         String?  @db.VarChar(4)
  status       String?  @db.VarChar(50)
  category     String?  @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]

  @@index([status])
  @@index([category])
  @@index([displayOrder])
  @@map("clients")
}

model Project {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @db.VarChar(200)
  slug             String?      @unique @db.VarChar(220)
  description      String?      @db.Text
  shortDescription String?      @db.Text
  category         String?      @db.VarChar(100)
  cover            String?      @db.VarChar(500)
  liveUrl          String?      @db.VarChar(500)
  caseStudyUrl     String?      @db.VarChar(500)
  featured         Boolean      @default(false)
  displayOrder     Int          @default(0)
  watermark        String?      @db.VarChar(100)
  themeClass       String?      @db.VarChar(200)
  glowColor        String?      @db.VarChar(30)
  year             String?      @db.VarChar(4)
  services         String?      @db.Text
  managerName      String?      @db.VarChar(150)
  designerName     String?      @db.VarChar(150)
  status           String       @default("قيد التنفيذ") @db.VarChar(50)
  priority         String       @default("متوسطة") @db.VarChar(50)
  progress         Int          @default(0)
  deadline         String?      @db.VarChar(10)
  clientId         String?      @db.Uuid
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  technologies Technology[]

  @@index([clientId])
  @@index([featured, displayOrder])
  @@index([status])
  @@map("projects")
}

model Technology {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar(100)
  category     String?   @db.VarChar(100)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects Project[]

  @@index([category])
  @@index([displayOrder])
  @@map("technologies")
}

model Settings {
  id              String   @id @default(uuid()) @db.Uuid
  siteName        String   @default("Codexa Agency") @db.VarChar(150)
  contactEmail    String   @default("contact@codexa.com") @db.VarChar(255)
  metaTitle       String   @default("Codexa | شركة تطوير برمجيات رائدة") @db.VarChar(255)
  metaDescription String?  @db.Text
  keywords        String?  @db.Text
  linkedinUrl     String?  @db.VarChar(500)
  facebookUrl     String?  @db.VarChar(500)
  instagramUrl    String?  @db.VarChar(500)
  updatedAt       DateTime @updatedAt

  @@map("settings")
}